<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- تشترط آبل «تسجيل الدخول بحساب Apple» على كل تطبيق يعرض دخولاً بمزوّد
	     خارجي (Guideline 4.8) — غيابه يعني رفض النسخة عند المراجعة. -->
	<key>com.apple.developer.applesignin</key>
	<array>
		<string>Default</string>
	</array>
	<!-- الإشعارات: development في البناء المحلي، وينقلب production تلقائياً
	     في أرشيف التوزيع. -->
	<key>aps-environment</key>
	<string>development</string>
</dict>
</plist>
