# للتشغيل المحلي خارج Docker — انسخه إلى backend/.env (متجاهَل في git)
# داخل Docker تُمرَّر القيم من docker-compose.yml وملف .env في جذر المشروع
# مخطّط المنصّة (prisma/v2) — الحيّ الوحيد؛ لا يوجد مخطّط v1 في AquaGo.
DATABASE_URL_V2="postgresql://aqua:aqua_secret@localhost:5433/aquago_v2?schema=public"
REDIS_URL="redis://localhost:6379"
JWT_SECRET="aquago-dev-secret-change-in-production"
PORT=3000

# دور العملية: api (تخدم الطلبات) أو worker (تستهلك الطوابير والمهام
# المجدولة). قيمة غير معروفة توقف الإقلاع — انظر src/v2/common/role.ts
ROLE=api

# تخزين الملفات: local (يكتب تحت STORAGE_LOCAL_PATH، للتطوير فقط) أو s3
# (متوافق مع DigitalOcean Spaces، للإنتاج). local افتراضي هنا عمداً —
# قيمة غير معروفة توقف الإقلاع كي لا يظن خادم إنتاج نفسه محلياً فيكتب على
# قرص حاوية يُستبدل عند كل نشر.
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./storage-dev
# مطلوبة فقط عند STORAGE_PROVIDER=s3:
STORAGE_S3_ENDPOINT=
STORAGE_S3_REGION=
STORAGE_S3_BUCKET=
STORAGE_S3_ACCESS_KEY=
STORAGE_S3_SECRET_KEY=
# اختياري: دومين Spaces CDN إن استُعمل رابط عام مباشر بدل مسار محروس
STORAGE_S3_PUBLIC_URL=

# مزود SMS: للنظام القديم (v1) فقط — v2 صار يستخدم Firebase Phone Auth
# ولم يعد يرسل SMS بنفسه. dev (بدون إرسال حقيقي) أو http (POST إلى
# SMS_API_URL مع Bearer SMS_API_KEY)
SMS_PROVIDER=dev
SMS_API_URL=
SMS_API_KEY=

# Firebase Admin SDK — مشترك بين إشعارات Push (FCM) والتحقق من تسجيل
# الدخول برقم الهاتف (Firebase Phone Auth، v2/auth/firebase-login).
# القيمة: محتوى ملف Service Account JSON من Firebase مُشفّر base64 بالكامل
FIREBASE_SERVICE_ACCOUNT_BASE64=

# دخول تطوير (v2/auth/dev-login): يدخل برقم الهاتف مباشرة بدون Firebase
# وبدون أي تحقق — مسموح تلقائياً خارج الإنتاج (NODE_ENV != production).
# فعّله صراحة بالإنتاج فقط لبيئة staging عزلاء عن بيانات حقيقية.
AUTH_DEV_LOGIN=0

# مزود إشعارات Push: dev (بدون إرسال حقيقي) أو firebase (Admin SDK)
FCM_PROVIDER=dev

# تنبيهات فريق العمليات عبر بوت تيليجرام: dev (تسجيل بالـ log فقط) أو
# real (إرسال حقيقي لقناة واحدة — الفئة مكتوبة داخل نص الرسالة نفسه).
# الـ chat_id سالب عادة (يبدأ بـ -100 للمجموعات/القنوات الكبيرة).
TELEGRAM_PROVIDER=dev
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
