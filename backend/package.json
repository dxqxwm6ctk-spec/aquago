{
  "name": "aquago-backend",
  "version": "1.0.0",
  "description": "AquaGo water delivery platform API - أكوا جو لتوصيل المياه",
  "private": true,
  "scripts": {
    "build": "nest build",
    "check:env": "node scripts/check-env.js",
    "test": "ts-node --project test/tsconfig.json test/run-all.ts",
    "test:docker": "node -e \"process.env.PHASE3_INCLUDE_DOCKER='1'; require('child_process').execSync('npx ts-node --project test/tsconfig.json test/run-all.ts', {stdio:'inherit', env: process.env})\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/src/main.js",
    "postinstall": "prisma generate --schema prisma/v2/schema.prisma",
    "v2:generate": "prisma generate --schema prisma/v2/schema.prisma",
    "v2:migrate": "prisma migrate dev --schema prisma/v2/schema.prisma",
    "v2:deploy": "prisma migrate deploy --schema prisma/v2/schema.prisma",
    "v2:status": "prisma migrate status --schema prisma/v2/schema.prisma",
    "v2:seed": "ts-node prisma/seed.v2.ts",
    "v2:geo:import": "ts-node prisma/import-geo.ts",
    "v2:verify": "ts-node prisma/verify.v2.ts",
    "v2:sim": "ts-node src/v2/dispatch/dispatch-sim.ts",
    "v2:storage:backfill": "ts-node prisma/backfill-object-storage.ts",
    "leads:import": "ts-node src/v2/outreach/import-leads.cli.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1127.0",
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.15",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/platform-socket.io": "^10.4.15",
    "@nestjs/serve-static": "^4.0.2",
    "@nestjs/websockets": "^10.4.15",
    "@prisma/client": "^5.22.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "@socket.io/redis-emitter": "^5.1.0",
    "@types/nodemailer": "^8.0.1",
    "bullmq": "^5.80.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cookie-parser": "^1.4.7",
    "firebase-admin": "^13.10.0",
    "ioredis": "^5.11.1",
    "nodemailer": "^9.0.6",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.10.2",
    "@types/qrcode": "^1.5.6",
    "prisma": "^5.22.0",
    "socket.io-client": "^4.8.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.v2.ts"
  }
}
